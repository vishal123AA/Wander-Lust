<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0rem 1rem 0rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .search-btn:hover{
    background-color: #fe424d;
    color: #fff;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }
  #search-input{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }

  @media (max-width: 768px) {
    #search-input {
      padding: 0.5rem 1rem; /* Reduces huge padding on small screens */
    }
    .search-btn {
      padding: 0 0.8rem; /* Shrink button width */
    }
    .search-btn i {
      margin-right: 0; /* Remove icon margin since we'll hide the text */
    }
  }

  /* --- Desktop Layout: Perfect Centering --- */
  @media (min-width: 768px) {
    /* Forces the left and right sides to be exactly equal in width */
    .left-nav-section, .right-nav-section {
      flex: 1.5; 
    }
    .right-nav-section {
      flex: 1; 
    }
    .search-wrapper {
      flex: 0 1 500px; /* Search bar max-width is 500px */
      margin: 0 auto;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top pb-1">
  <div class="container-fluid flex wrap">
    <div class="d-flex align-items-center justify-content-between w-100 flex-nowrap">
      <div class="d-flex align-items-center left-nav-section">
        <a class="navbar-brand me-2" href="/listings"><i class="fa-regular fa-compass"></i></a>
        <a class="nav-link me-2" aria-current="page" href="/listings" style="white-space: nowrap;">Explore</a>
       </div>

      <div class="search-wrapper flex-grow-1 mx-2 mx-md-0">
        <form class="d-flex needs-validation w-100" novalidate role="search" method="GET" action="/listings/search" style="max-width: 500px;">
          <input class="form-control me-1" type="search" placeholder="Search destinations" id="search-input" name="q" required aria-label="Search">
          <div class="invalid-feedback">Invalid Search</div>
          <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i><span class="d-none d-md-inline">Search</span></button>
        </form>
      </div>

      <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>  

    <div class="collapse navbar-collapse right-nav-section" id="navbarNavAltMarkup">
      <!-- <div class="navbar-nav">
        <a class="nav-link" aria-current="page" href="/listings">Explore</a>
      </div> -->
      <div class="navbar-nav ms-auto text-center mt-3 mt-md-0 bg-white  flex-md-row align-items-center justify-content-end">
        <a class="nav-link text-nowrap me-md-3" href="/listings/new">Airbnb your home</a>
       <% if(!currUser){ %> 
        <a class="nav-link text-nowrap me-md-3" aria-current="page" href="/signup"><b>Sign up</b></a>
        <a class="nav-link text-nowrap me-md-3" href="/login"><b>Log in</b></a>
        <% } %>
        <% if(currUser) { %>
        <a class="nav-link text-nowrap me-md-3" href="/logout">Log out</a>
        <%}%>
      </div>
    </div>
  </div>
</nav>